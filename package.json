{
  "name": "deliver-assets-pro",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "22.23.x",
    "npm": "10.9.x"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc",
    "lint": "eslint . --max-warnings=0",
    "validate:routes": "node scripts/validate-routes.mjs",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "generate:release": "node scripts/write-build-metadata.mjs",
    "generate:routes": "node scripts/generate-static-routes.mjs",
    "verify:site": "node scripts/verify-public-site.mjs",
    "verify:quality": "node scripts/verify-quality-baseline.mjs",
    "verify:browser": "node scripts/verify-mobile-navigation.mjs",
    "verify:motion": "node scripts/verify-motion-system.mjs",
    "build:site": "vite build && npm run generate:release && npm run generate:routes && npm run verify:site && npm run verify:quality && npm run verify:browser && npm run verify:motion",
    "build": "npm run validate:routes && npm run typecheck && npm run lint && npm run test:coverage && npm run build:site",
    "quality": "npm run build",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.9.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "packageManager": "npm@10.9.8"
}
